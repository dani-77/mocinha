#!/bin/sh
# /usr/lib/mocinha/mocinha-root --- run by pkexec (polkit action org.mocinha.installer).
#   mocinha-root [VAR=value]... -- [mocinha arguments]
# Only the session display variables are accepted before "--"; anything else is refused.
while [ $# -gt 0 ]; do
	case "$1" in
		--) shift; break ;;
		WAYLAND_DISPLAY=*|XDG_RUNTIME_DIR=*|DISPLAY=*|XAUTHORITY=*|XDG_SESSION_TYPE=*|GDK_BACKEND=*)
			export "$1"; shift ;;
		*) echo "mocinha-root: refusing argument before --: $1" >&2; exit 2 ;;
	esac
done
exec python3 /usr/share/mocinha/bin/mocinha "$@"
