#!/usr/bin/env python3
"""Mocinha Installer runner.

Starts the GTK3 interface if a display server is available,
or routes to the CLI tool.
"""

from pathlib import Path
import os
import sys

# Ensure repository root is in sys.path
repo_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(repo_root))

if __name__ == "__main__":
    has_display = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    args = sys.argv[1:]

    # If explicit CLI command or no display server, run CLI
    cli_commands = {"probe", "check-manifest", "plan", "install", "network", "--cli", "-h", "--help"}
    if not has_display or any(arg in cli_commands for arg in args):
        from mocinha.frontends.cli.main import main
        main()
    else:
        from mocinha.frontends.gtk3.app import run_gtk_app
        manifest_arg = args[0] if args else None
        sys.exit(run_gtk_app(manifest_arg))
